# ===== Backend (FastAPI + worker) =====
DATABASE_URL=postgresql+psycopg://sqlarena_app:DOI_MAT_KHAU@localhost:5432/sqlarena_app
JWT_SECRET=DOI_CHUOI_NGAU_NHIEN_DAI        # PHẢI trùng secret của module Auth (HS256, claim sub = user_id)
APP_TIMEZONE=Asia/Ho_Chi_Minh              # ngày tính trần ngân sách LLM
CORS_ORIGINS=http://localhost:5173
WORLD_NAME=enterprise_v1

# ===== Engine AI (cùng tên biến với ai/.env.example; biến môi trường thắng file này) =====
# Model/host mặc định chạy qua Local Ollama (Model A: llama3, Model B: qwen2.5-coder:7b)
OLLAMA_HOST=http://localhost:11434
MODEL_NAME=llama3
REVIEW_MODEL_NAME=qwen2.5-coder:7b
REVIEW_AUDIT_MODEL_NAME=qwen2.5-coder:7b
# Enterprise DB (chỉ đọc) — bắt buộc điền
CATALOG_DB_HOST=localhost
CATALOG_DB_PORT=5432
CATALOG_DB_NAME=enterprise_db
CATALOG_DB_USER=
CATALOG_DB_PASSWORD=
ENTERPRISE_DB_HOST=localhost
ENTERPRISE_DB_PORT=5432
ENTERPRISE_DB_NAME=enterprise_db
ENTERPRISE_DB_USER=sqlarena_ai_ro
ENTERPRISE_DB_PASSWORD=
