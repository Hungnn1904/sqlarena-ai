# Copy this file to ai/.env only if ai/.env does not exist.
# Fill in your local PostgreSQL passwords. Do not commit ai/.env.
AI_PROVIDER=ollama
MODEL_NAME=llama3
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=240
OLLAMA_CONTEXT_SIZE=8192
GENERATION_TEMPERATURE=0.35
RETRY_TEMPERATURE=0.15
MAX_RETRIES=2
STATEMENT_TIMEOUT_MS=10000
MAX_RESULT_ROWS=100000
DUPLICATE_HIGH=0.85
DUPLICATE_REVIEW=0.65
WORLD_ID=enterprise_v1
RULES_PATH=question_create/enterprise_50_question_rules_v1.md

ARENA_DB_HOST=localhost
ARENA_DB_PORT=5432
ARENA_DB_NAME=sqlarena_db
ARENA_DB_USER=postgres
ARENA_DB_PASSWORD=

CATALOG_DB_HOST=localhost
CATALOG_DB_PORT=5432
CATALOG_DB_NAME=enterprise_db
CATALOG_DB_USER=postgres
CATALOG_DB_PASSWORD=

ENTERPRISE_DB_HOST=localhost
ENTERPRISE_DB_PORT=5432
ENTERPRISE_DB_NAME=enterprise_db
ENTERPRISE_DB_USER=
ENTERPRISE_DB_PASSWORD=
