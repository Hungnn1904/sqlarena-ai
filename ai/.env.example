# Copy this file to ai/.env only if ai/.env does not exist.
# Fill in your local PostgreSQL passwords. Do not commit ai/.env.
AI_PROVIDER=ollama
MODEL_NAME=llama3
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=240
OLLAMA_CONTEXT_SIZE=8192
GENERATION_TEMPERATURE=0.35
RETRY_TEMPERATURE=0.15
MAX_RETRIES=2
STATEMENT_TIMEOUT_MS=10000
MAX_RESULT_ROWS=100000
DUPLICATE_HIGH=0.85
DUPLICATE_REVIEW=0.65
WORLD_ID=enterprise_v1
RULES_PATH=question_create/enterprise_50_question_rules_v1.md

ARENA_DB_HOST=localhost
ARENA_DB_PORT=5432
ARENA_DB_NAME=sqlarena_db
ARENA_DB_USER=postgres
ARENA_DB_PASSWORD=

CATALOG_DB_HOST=localhost
CATALOG_DB_PORT=5432
CATALOG_DB_NAME=enterprise_db
CATALOG_DB_USER=postgres
CATALOG_DB_PASSWORD=

ENTERPRISE_DB_HOST=localhost
ENTERPRISE_DB_PORT=5432
ENTERPRISE_DB_NAME=enterprise_db
ENTERPRISE_DB_USER=
ENTERPRISE_DB_PASSWORD=

# --- Review pipeline (ai/review.py) ---
# Model B: nen KHAC Model A (khac ho model) de loi giai cua hai model it trung loi nhau.
REVIEW_MODEL_NAME=qwen2.5-coder:7b
REVIEW_OLLAMA_HOST=
# Co the dung 2 model khac ho: REVIEW_MODEL_NAME=qwen2.5-coder:7b,qwen3:8b (REVIEW_SAMPLES >= so model)
REVIEW_FEWSHOT=2
REVIEW_SAMPLES=3
REVIEW_SAMPLE_RETRIES=1
REVIEW_TEMPERATURE=0.3
REVIEW_NUM_PREDICT=900
REVIEW_MAX_ROWS=5000
# Model B khong giai duoc khong co nghia cau hoi sai; chuyen nguoi review.
REVIEW_ZERO_VALID_ACTION=needs_human
# De trong, hoac true/false neu model co che do thinking (vd qwen3) can tat/bat
REVIEW_THINK=
# Tuy chon: ten DB variant cung schema, cach nhau dau phay (vd enterprise_v2,enterprise_v3)
REVIEW_VARIANT_DBS=

# Auditor tach biet neu model da cai; audit loi ngu nghia khong phai bang chung tuyet doi.
REVIEW_SEMANTIC_AUDIT=true
REVIEW_AUDIT_MODEL_NAME=llama3:latest
REVIEW_AUDIT_NUM_PREDICT=600
# Sinh lai toi da 2 vong khi gap loi co the sua; moi vong chay lai toan bo guard/audit.
REVIEW_REPAIR_ROUNDS=2
