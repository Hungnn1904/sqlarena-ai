# Copy this file to .env for Docker / VPS deployment (do NOT commit real .env).

# --- Docker / VPS Ports & Secrets ---
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PG_PASSWORD
ENTERPRISE_DB_PASSWORD=CHANGE_ME_RO_PASSWORD
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_SECRET
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# Leave empty on VPS without domain so frontend uses same-origin /api/ proxy on :3000
NEXT_PUBLIC_API_URL=

# --- AI Provider (API Thật https://apithat.dev/keys hoặc Ollama nội bộ) ---
AI_PROVIDER=ollama
OLLAMA_HOST=http://host.docker.internal:11434
APITHAT_API_KEY=
APITHAT_BASE_URL=https://apithat.dev/v1
APITHAT_MODEL=gpt-5.6-sol

# --- Local Native Development ---
ARENA_DB_HOST=localhost
ARENA_DB_PORT=5432
ARENA_DB_NAME=sqlarena_db
ARENA_DB_USER=postgres
ARENA_DB_PASSWORD=CHANGE_ME

ENTERPRISE_DB_HOST=localhost
ENTERPRISE_DB_PORT=5432
ENTERPRISE_DB_NAME=enterprise_db
ENTERPRISE_DB_USER=sqlarena_ai_ro

STATEMENT_TIMEOUT_MS=10000
MAX_RESULT_ROWS=100000
EXPECTED_TIMEOUT_MS=15000
