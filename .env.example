# Copy this file to SQL_run_API/.env and fill in your local PostgreSQL values.
# Do not commit the real .env file.

# Database that stores questions, expected results, users and submissions.
ARENA_DB_HOST=localhost
ARENA_DB_PORT=5432
ARENA_DB_NAME=sqlarena_db
ARENA_DB_USER=postgres
ARENA_DB_PASSWORD=CHANGE_ME

# Read-only connection used to execute learner SELECT queries.
# This role is created by postgre/enterprise_db/03_create_readonly_role.sql.
ENTERPRISE_DB_HOST=localhost
ENTERPRISE_DB_PORT=5432
ENTERPRISE_DB_NAME=enterprise_db
ENTERPRISE_DB_USER=sqlarena_ai_ro
ENTERPRISE_DB_PASSWORD=CHANGE_ME

# API execution limits.
STATEMENT_TIMEOUT_MS=10000
MAX_RESULT_ROWS=100000

# Expected-result generator limit.
EXPECTED_TIMEOUT_MS=15000
